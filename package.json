{
  "name": "triase-net",
  "version": "0.1.0",
  "private": true,
  "description": "TRIASE-Net - Sistem Komunikasi Aman untuk Layanan Aduan Mahasiswa (ZTNA + Enkripsi Adaptif)",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:roles": "tsx scripts/create-login-roles.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:seed:sql": "tsx scripts/apply-dev-seed.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:runtime": "tsx scripts/seed-runtime-demo.ts",
    "test": "vitest run",
    "test:db": "tsx scripts/test-runtime-db.ts",
    "test:watch": "vitest",
    "admin:create": "tsx scripts/create-admin.ts",
    "security:preflight": "node scripts/check-auth-production.mjs",
    "test:auth:db": "node --env-file=.env scripts/qa-auth-hardening.mjs",
    "mail:worker": "node scripts/mail-worker.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@node-rs/argon2": "^2.2.1",
    "@vercel/functions": "^3.10.1",
    "kysely": "^0.28.2",
    "lucide-react": "^0.469.0",
    "motion": "^14.0.0",
    "next": "^15.1.4",
    "nodemailer": "^10.1.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
